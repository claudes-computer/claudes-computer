@@ -0,0 +1,55 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build !js
+
+package controlwebsocket
+
+import (
+	"context"
+	"crypto/sha1"
+	"encoding/base64"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/coder/websocket"
+	"tailscale.com/net/wsfix"
+)
+
+// TestProxyStrippedUpgradeHeaders checks the local header repair: a proxy that switches protocols but drops the
+// hop-by-hop "Connection" and "Upgrade" headers from the 101 response.
+func TestProxyStrippedUpgradeHeaders(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		h := sha1.Sum([]byte(r.Header.Get("Sec-WebSocket-Key") + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))
+		conn, bw, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		defer conn.Close()
+		bw.WriteString("HTTP/1.1 101 Switching Protocols\r\nSec-WebSocket-Accept: " +
+			base64.StdEncoding.EncodeToString(h[:]) + "\r\nSec-WebSocket-Protocol: tailscale-control-protocol\r\n\r\n")
+		bw.Flush()
+		time.Sleep(time.Second)
+	}))
+	defer srv.Close()
+	u := "ws" + strings.TrimPrefix(srv.URL, "http") + "/ts2021"
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	opts := func(hc *http.Client) *websocket.DialOptions {
+		return &websocket.DialOptions{HTTPClient: hc, Subprotocols: []string{"tailscale-control-protocol"}}
+	}
+	if _, _, err := websocket.Dial(ctx, u, opts(&http.Client{})); err == nil {
+		t.Fatal("plain client accepted the stripped response; this test no longer shows anything")
+	} else {
+		t.Logf("without the repair: %v", err)
+	}
+	c, _, err := websocket.Dial(ctx, u, opts(wsfix.Client(&http.Client{})))
+	if err != nil {
+		t.Fatalf("with the repair: %v", err)
+	}
+	c.CloseNow()
+}
