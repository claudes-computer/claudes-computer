diff -ruN -x state -x 'tailscale*-ws' a/net/wsfix/wsfix.go b/net/wsfix/wsfix.go
--- a/net/wsfix/wsfix.go	1969-12-31 16:00:00.000000000 -0800
+++ b/net/wsfix/wsfix.go	2026-11-27 06:25:30.441648605 -0800
@@ -0,0 +1,215 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+// Package wsfix makes WebSocket handshakes work through proxies that switch protocols but drop the hop-by-hop
+// "Connection" and "Upgrade" headers from the 101 response (seen in some AI agent sandboxes). net/http only
+// hands over the connection of a 101 response that has both headers, so this does the handshake itself: it
+// dials as the given *http.Transport would (its dialer, proxy with CONNECT and credentials, TLS settings), writes
+// the request, reads the response leniently, and gives the WebSocket library a response it accepts.
+// Local addition to this project's Tailscale build, not part of upstream Tailscale.
+package wsfix
+
+import (
+	"bufio"
+	"context"
+	"crypto/tls"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"time"
+)
+
+// Client returns a client for websocket.Dial that does the handshake as described in the package comment.
+// If hc's transport isn't an *http.Transport, hc is returned unchanged.
+func Client(hc *http.Client) *http.Client {
+	if hc == nil {
+		hc = &http.Client{}
+	}
+	tr, ok := hc.Transport.(*http.Transport)
+	if hc.Transport == nil {
+		tr, ok = http.DefaultTransport.(*http.Transport), true
+	}
+	if !ok {
+		return hc
+	}
+	c := *hc
+	c.Transport = roundTripper{tr}
+	return &c
+}
+
+type roundTripper struct{ tr *http.Transport }
+
+func (rt roundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	ctx := req.Context()
+	conn, err := rt.dial(ctx, req)
+	if err != nil {
+		return nil, err
+	}
+	if d, ok := ctx.Deadline(); ok {
+		conn.SetDeadline(d)
+	} else {
+		conn.SetDeadline(time.Now().Add(30 * time.Second))
+	}
+	br := bufio.NewReader(conn)
+	if err := req.Write(conn); err != nil {
+		conn.Close()
+		return nil, err
+	}
+	resp, err := http.ReadResponse(br, req)
+	if err != nil {
+		conn.Close()
+		return nil, err
+	}
+	conn.SetDeadline(time.Time{})
+	if resp.StatusCode != http.StatusSwitchingProtocols {
+		resp.Body = closeBoth{resp.Body, conn}
+		return resp, nil
+	}
+	if resp.Header.Get("Connection") == "" {
+		resp.Header.Set("Connection", "Upgrade")
+	}
+	if resp.Header.Get("Upgrade") == "" {
+		resp.Header.Set("Upgrade", "websocket")
+	}
+	resp.Body = rwc{br, conn}
+	return resp, nil
+}
+
+func hostPort(u *url.URL) string {
+	if u.Port() != "" {
+		return u.Host
+	}
+	if u.Scheme == "https" || u.Scheme == "wss" {
+		return net.JoinHostPort(u.Hostname(), "443")
+	}
+	return net.JoinHostPort(u.Hostname(), "80")
+}
+
+func (rt roundTripper) dial(ctx context.Context, req *http.Request) (net.Conn, error) {
+	tr := rt.tr
+	dialer := tr.DialContext
+	if dialer == nil {
+		dialer = (&net.Dialer{}).DialContext
+	}
+	secure := req.URL.Scheme == "https" || req.URL.Scheme == "wss"
+	addr := hostPort(req.URL)
+	var proxyURL *url.URL
+	if tr.Proxy != nil {
+		var err error
+		if proxyURL, err = tr.Proxy(req); err != nil {
+			return nil, err
+		}
+	}
+	var conn net.Conn
+	var err error
+	switch {
+	case proxyURL != nil:
+		if conn, err = dialer(ctx, "tcp", hostPort(proxyURL)); err != nil {
+			return nil, err
+		}
+		if proxyURL.Scheme == "https" {
+			tc := tls.Client(conn, &tls.Config{ServerName: proxyURL.Hostname()})
+			if err := tc.HandshakeContext(ctx); err != nil {
+				conn.Close()
+				return nil, err
+			}
+			conn = tc
+		}
+		if err := connect(ctx, tr, conn, proxyURL, addr); err != nil {
+			conn.Close()
+			return nil, err
+		}
+	case secure && tr.DialTLSContext != nil:
+		return tr.DialTLSContext(ctx, "tcp", addr)
+	default:
+		if conn, err = dialer(ctx, "tcp", addr); err != nil {
+			return nil, err
+		}
+	}
+	if !secure {
+		return conn, nil
+	}
+	cfg := &tls.Config{}
+	if tr.TLSClientConfig != nil {
+		cfg = tr.TLSClientConfig.Clone()
+	}
+	if cfg.ServerName == "" {
+		cfg.ServerName = req.URL.Hostname()
+	}
+	cfg.NextProtos = []string{"http/1.1"}
+	tc := tls.Client(conn, cfg)
+	if err := tc.HandshakeContext(ctx); err != nil {
+		conn.Close()
+		return nil, err
+	}
+	return tc, nil
+}
+
+// connect asks the proxy on conn for a tunnel to addr, with the credentials in proxyURL and the transport's
+// proxy CONNECT headers.
+func connect(ctx context.Context, tr *http.Transport, conn net.Conn, proxyURL *url.URL, addr string) error {
+	hdr := http.Header{}
+	for k, v := range tr.ProxyConnectHeader {
+		hdr[k] = v
+	}
+	if tr.GetProxyConnectHeader != nil {
+		h, err := tr.GetProxyConnectHeader(ctx, proxyURL, addr)
+		if err != nil {
+			return err
+		}
+		for k, v := range h {
+			hdr[k] = v
+		}
+	}
+	if u := proxyURL.User; u != nil && hdr.Get("Proxy-Authorization") == "" {
+		pw, _ := u.Password()
+		hdr.Set("Proxy-Authorization", "Basic "+base64.StdEncoding.EncodeToString([]byte(u.Username()+":"+pw)))
+	}
+	creq := &http.Request{Method: "CONNECT", URL: &url.URL{Opaque: addr}, Host: addr, Header: hdr}
+	if d, ok := ctx.Deadline(); ok {
+		conn.SetDeadline(d)
+		defer conn.SetDeadline(time.Time{})
+	}
+	if err := creq.Write(conn); err != nil {
+		return err
+	}
+	// Read the reply one byte at a time so nothing after it (the TLS handshake) is left in a buffer.
+	resp, err := http.ReadResponse(bufio.NewReaderSize(oneByteReader{conn}, 16), creq)
+	if err != nil {
+		return err
+	}
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("proxy CONNECT to %s: %s", addr, resp.Status)
+	}
+	return nil
+}
+
+type oneByteReader struct{ r io.Reader }
+
+func (o oneByteReader) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	return o.r.Read(p[:1])
+}
+
+type rwc struct {
+	r *bufio.Reader
+	c net.Conn
+}
+
+func (x rwc) Read(p []byte) (int, error)  { return x.r.Read(p) }
+func (x rwc) Write(p []byte) (int, error) { return x.c.Write(p) }
+func (x rwc) Close() error                { return x.c.Close() }
+
+type closeBoth struct {
+	io.ReadCloser
+	c net.Conn
+}
+
+func (x closeBoth) Close() error { return errors.Join(x.ReadCloser.Close(), x.c.Close()) }
