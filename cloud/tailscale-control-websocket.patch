+
+// bundler collects the WebSocket library's small writes (it writes frames in 4 KB pieces) and passes them on
+// together, at 64 KB or after 300 µs, whichever comes first. Some HTTP proxies have a cost per write that
+// otherwise caps the connection at a few Mbit/s. (ccrd patch)
+type bundler struct {
+	net.Conn
+	mu      sync.Mutex
+	buf     []byte
+	pending bool
+	err     error
+}
+
+func newBundler(c net.Conn) *bundler { return &bundler{Conn: c, buf: make([]byte, 0, 64<<10)} }
+
+func (b *bundler) Write(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.err != nil {
+		return 0, b.err
+	}
+	if len(b.buf)+len(p) > cap(b.buf) {
+		if err := b.flushLocked(); err != nil {
+			return 0, err
+		}
+		if len(p) >= cap(b.buf) {
+			return b.Conn.Write(p)
+		}
+	}
+	b.buf = append(b.buf, p...)
+	if !b.pending {
+		b.pending = true
+		time.AfterFunc(300*time.Microsecond, func() {
+			b.mu.Lock()
+			defer b.mu.Unlock()
+			b.pending = false
+			b.flushLocked()
+		})
+	}
+	return len(p), nil
+}
+
+func (b *bundler) flushLocked() error {
+	if len(b.buf) == 0 || b.err != nil {
+		return b.err
+	}
+	_, err := b.Conn.Write(b.buf)
+	b.buf = b.buf[:0]
+	b.err = err
+	return err
+}
