 	if a.Hostname == "" {
 		return nil, errors.New("required Dialer.Hostname empty")
 	}
-	return a.dial(ctx)
+	if controlWebsocketFirst() {
+		return a.dialWebsocket(ctx)
+	}
+	c, err := a.dial(ctx)
+	if wantsWebsocketFallback(err) {
+		a.logf("controlhttp: protocol upgrade refused (%v); trying WebSocket", err)
+		if wc, werr := a.dialWebsocket(ctx); werr == nil {
+			return wc, nil
+		} else {
+			a.logf("controlhttp: WebSocket failed too: %v", werr)
+		}
+	}
+	return c, err
 }
 
